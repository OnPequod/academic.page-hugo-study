# Copy to .env (ignored by git) and fill in. The Makefile reads it.
# Create a content key at https://academic.page/admin/account/api (Pro plan).
ACADEMIC_PAGE_TOKEN=
# The number in the site's admin address, such as 42 in /sites/42/posts.
ACADEMIC_PAGE_SITE=
# Optional. Defaults to https://academic.page/api/v1.
# ACADEMIC_PAGE_BASE_URL=https://academic.page/api/v1
