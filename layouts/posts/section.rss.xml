{{- /* RSS for posts. Uses the API's site name and each post's full HTML. */ -}}
{{- $site := partialCached "api/site.html" "site" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ .Title }} | {{ $site.name }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ $site.homepage.description | default (printf "Posts from %s" $site.name) }}</description>
    <language>{{ $site.locale | default "en" }}</language>
    {{- with .Pages.ByDate.Reverse }}{{ with index . 0 }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{- end }}{{ end }}
    {{- with .OutputFormats.Get "rss" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- end }}
    {{- range first 50 .Pages.ByDate.Reverse }}
    {{- $r := partial "api/record.html" . }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      {{- with $r.author }}<dc:creator>{{ .name }}</dc:creator>{{ end }}
      {{- range $r.tags }}
      <category>{{ .name }}</category>
      {{- end }}
      <description>{{ .Content | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
